NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
# 네이버 지도 (NCP 콘솔 > Maps > Application의 Client ID, 서비스 URL에 http://localhost:3000 등록)
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=
# 토스 결제창형 테스트 클라이언트 키(test_gck_), 서버는 같은 상점의 test_gsk_ 키 사용
NEXT_PUBLIC_TOSS_CLIENT_KEY=test_gck_docs_Ovk5rk1EwkEbP0W43n07xlzm
# 소셜 로그인·연동 (클라이언트 ID는 api .env와 같은 값, 시크릿은 넣지 않음)
# 콜백 주소는 각 개발자 콘솔에 등록한 주소와 같아야 하며 제공자마다 달라야 함
NEXT_PUBLIC_KAKAO_REST_API_KEY=
NEXT_PUBLIC_KAKAO_REDIRECT_URI=http://localhost:3000/auth/kakao/callback
NEXT_PUBLIC_NAVER_CLIENT_ID=
NEXT_PUBLIC_NAVER_REDIRECT_URI=http://localhost:3000/auth/naver/callback
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
