// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// 조순님 파트
// auth_accounts
enum AccountType {
  USER
  PHOTOGRAPHER
}

model auth_accounts {
  id           String      @id @default(uuid(7)) @db.Uuid
  account_type AccountType
  // 유저·작가 공통 닉네임. 대소문자를 구분하지 않고 전체에서 중복될 수 없다
  // lower(nickname) unique 인덱스는 Prisma로 표현할 수 없어 migration SQL에만 있다 (auth_accounts_nickname_lower_key)
  nickname     String
  created_at   DateTime    @default(now())
  updated_at   DateTime    @updatedAt

  auth_provider              auth_providers[]
  auth_refresh_token         auth_refresh_tokens[]
  user                       users?
  photographer               photographers?
  reservation_cancel_request reservation_cancel_requests[]
  notification               notifications[]
  chatMessage                chat_messages[]
}

// auth_providers
enum Provider {
  BASIC
  GOOGLE
  KAKAO
  NAVER
}

model auth_providers {
  id               String        @id @default(uuid(7)) @db.Uuid
  auth_account_id  String        @db.Uuid
  provider         Provider
  provider_email   String
  password_hash    String?
  provider_user_id String?
  created_at       DateTime      @default(now())
  auth_account     auth_accounts @relation(fields: [auth_account_id], references: [id], onDelete: Cascade)

  @@unique([auth_account_id, provider])
  @@unique([provider, provider_email])
  @@unique([provider, provider_user_id])
}

// auth_refresh_tokens
model auth_refresh_tokens {
  id              String    @id @default(uuid(7)) @db.Uuid
  auth_account_id String    @db.Uuid
  token_hash      String    @unique
  family_id       String    @default(uuid(7)) @db.Uuid
  // 이 로그인 세션을 시작한 로그인 방식 (회전해도 이어받음). 기존 세션은 BASIC으로 채운다
  provider        Provider  @default(BASIC)
  revoked_at      DateTime?
  replaced_by_id  String?   @unique @db.Uuid
  created_at      DateTime  @default(now())

  auth_account auth_accounts        @relation(fields: [auth_account_id], references: [id], onDelete: Cascade)
  replaced_by  auth_refresh_tokens? @relation("TokenReplacement", fields: [replaced_by_id], references: [id], onDelete: SetNull)
  replace      auth_refresh_tokens? @relation("TokenReplacement")

  @@index([family_id])
}

// users
model users {
  id                String   @id @default(uuid(7)) @db.Uuid
  auth_account_id   String   @unique @db.Uuid
  profile_image_url String?
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  auth_account     auth_accounts        @relation(fields: [auth_account_id], references: [id], onDelete: Cascade)
  photoLike        photo_likes[]
  photographerSave photographer_saves[]
  chatRoom         chat_rooms[]
  payment          payments[]
  review           reviews[]
  reservation      reservations[]
  interaction      user_interactions[]
  feature          user_features?
}

// photographers
model photographers {
  id                String     @id @default(uuid(7)) @db.Uuid
  auth_account_id   String     @unique @db.Uuid
  profile_image_url String?
  career            Int?
  regions           Region[]   @default([])
  categories        Category[] @default([])
  introduction      String?
  created_at        DateTime   @default(now())
  updated_at        DateTime   @updatedAt

  auth_account        auth_accounts          @relation(fields: [auth_account_id], references: [id], onDelete: Cascade)
  product             products[]
  photo               photos[]
  photographerSave    photographer_saves[]
  chatRoom            chat_rooms[]
  quote               quotes[]
  payment             payments[]
  reservation         reservations[]
  reviews             reviews[]
  representativePhoto representative_photos?
  reviewSummary       review_summaries?
  interaction         user_interactions[]
  feature             photographer_features?
}

// reservations
enum ReservationStatus {
  CONFIRMED
  SHOOT_COMPLETED
  DELIVERED
  PURCHASE_CONFIRMED
  CANCELED
}

model reservations {
  id              String            @id @default(uuid(7)) @db.Uuid
  quote_id        String?           @unique @db.Uuid
  payment_id      String?           @unique @db.Uuid
  user_id         String?           @db.Uuid
  photographer_id String?           @db.Uuid
  status          ReservationStatus
  shoot_at        DateTime
  location        String
  total_amount    Int
  created_at      DateTime          @default(now())
  updated_at      DateTime          @updatedAt

  // 구매 확정 시각 (유저가 직접 확정하거나 자동 확정된 시각, 확정 전이면 null)
  purchase_confirmed_at DateTime?

  user         users?         @relation(fields: [user_id], references: [id], onDelete: SetNull)
  photographer photographers? @relation(fields: [photographer_id], references: [id], onDelete: SetNull)
  quote        quotes?        @relation(fields: [quote_id], references: [id], onDelete: SetNull)
  payment      payments?      @relation(fields: [payment_id], references: [id], onDelete: SetNull)

  reservation_cancel_request reservation_cancel_requests[]
  deliverable                deliverables?
  chatMessage                chat_messages[]
  review                     reviews?

  @@index([user_id])
  @@index([photographer_id])
}

// reservation_cancel_requests
enum CancelStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model reservation_cancel_requests {
  id                      String       @id @default(uuid(7)) @db.Uuid
  reservation_id          String       @db.Uuid
  requested_by_account_id String       @db.Uuid
  reason                  String // 취소를 요청한 사람(유저 또는 작가)의 사유
  accept_reason           String? // 작가가 유저의 취소 요청을 수락할 때의 사유
  status                  CancelStatus
  processed_at            DateTime?
  created_at              DateTime     @default(now())
  updated_at              DateTime     @updatedAt

  auth_account auth_accounts @relation(fields: [requested_by_account_id], references: [id], onDelete: Cascade)
  reservation  reservations  @relation(fields: [reservation_id], references: [id], onDelete: Cascade)
}

// deliverables
model deliverables {
  id                String   @id @default(uuid(7)) @db.Uuid
  reservation_id    String   @unique @db.Uuid
  link              String
  expiration_period DateTime
  notice            String?
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  reservation reservations @relation(fields: [reservation_id], references: [id], onDelete: Cascade)
}

// products
model products {
  id                String   @id @default(uuid(7)) @db.Uuid
  photographer_id   String   @db.Uuid
  name              String
  price             Int
  duration_minutes  Int
  photo_count       Int
  includes_original Boolean
  common_notice     String?
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  photographer photographers @relation(fields: [photographer_id], references: [id], onDelete: Cascade)

  @@index([photographer_id])
}

// 용일님 파트
// categories, styles, regions (화면 표시 순서대로 선언)
enum Category {
  WEDDING
  COUPLE
  FAMILY
  FRIENDS
  GRADUATION
  PROFILE
  EVENT
  PET
  ETC
}

enum Style {
  NATURAL
  BRIGHT
  FILM
  VINTAGE
  CINEMATIC
  MONOCHROME
  MINIMAL
  DREAMY
}

enum Region {
  SEOUL
  DAEGU
  GWANGJU
  ULSAN
  GYEONGGI
  CHUNGBUK
  JEONBUK
  GYEONGBUK
  JEJU
  BUSAN
  INCHEON
  DAEJEON
  SEJONG
  GANGWON
  CHUNGNAM
  JEONNAM
  GYEONGNAM
}

// photos
model photos {
  id               String     @id @default(uuid(7)) @db.Uuid
  photographer_id  String     @db.Uuid
  description      String?
  storage_location String
  width            Int
  height           Int
  categories       Category[] @default([])
  styles           Style[]    @default([])
  created_at       DateTime   @default(now())
  updated_at       DateTime   @updatedAt

  photographer        photographers           @relation(fields: [photographer_id], references: [id], onDelete: Cascade)
  photoKeyword        photo_keywords[]
  photoLike           photo_likes[]
  representativePhoto representative_photos[]
  interaction         user_interactions[]
  feature             photo_features?
  valueScore          photo_value_scores?

  @@index([photographer_id])
}

// photo_keywords & photo_likes & photographer_saves
model photo_keywords {
  id       String @id @default(uuid(7)) @db.Uuid
  photo_id String @db.Uuid
  keyword  String

  photo photos @relation(fields: [photo_id], references: [id], onDelete: Cascade)

  @@index([photo_id])
  @@index([keyword])
}

model photo_likes {
  user_id    String   @db.Uuid
  photo_id   String   @db.Uuid
  created_at DateTime @default(now())

  photo photos @relation(fields: [photo_id], references: [id], onDelete: Cascade)
  user  users  @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([photo_id, user_id])
  @@index([user_id])
}

model photographer_saves {
  user_id         String   @db.Uuid
  photographer_id String   @db.Uuid
  created_at      DateTime @default(now())

  photographer photographers @relation(fields: [photographer_id], references: [id], onDelete: Cascade)
  user         users         @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([photographer_id, user_id])
  @@index([user_id])
}

model representative_photos {
  photographer_id String @id @db.Uuid
  photo_id        String @db.Uuid

  photographer photographers @relation(fields: [photographer_id], references: [id], onDelete: Cascade)
  photo        photos        @relation(fields: [photo_id], references: [id], onDelete: Cascade)
}

// notifications
enum NotiType {
  NEW_MESSAGE
  NEW_INQUIRY
  NEW_QUOTE
  RESERVATION_CONFIRMED
  SHOOT_REMINDER
  DELIVERY_COMPLETED
  NEW_REVIEW
  CANCEL_REQUESTED
  CANCEL_REJECTED
  RESERVATION_CANCELED
}

enum NotiTargetType {
  CHAT_ROOM
  RESERVATION
  PHOTOGRAPHER_PROFILE
}

model notifications {
  id              String         @id @default(uuid(7)) @db.Uuid
  auth_account_id String         @db.Uuid
  type            NotiType
  target_type     NotiTargetType
  target_id       String
  message         String
  scheduled_at    DateTime?
  read_at         DateTime?
  created_at      DateTime       @default(now())

  auth_account auth_accounts @relation(fields: [auth_account_id], references: [id], onDelete: Cascade)

  @@index([auth_account_id, created_at])
}

// 영일님 파트
// chat_rooms
model chat_rooms {
  id              String   @id @default(uuid(7)) @db.Uuid
  user_id         String?  @db.Uuid
  photographer_id String?  @db.Uuid
  last_message_at DateTime @default(now())
  created_at      DateTime @default(now())

  user         users?          @relation(fields: [user_id], references: [id], onDelete: SetNull)
  photographer photographers?  @relation(fields: [photographer_id], references: [id], onDelete: SetNull)
  chatMessage  chat_messages[]
  quote        quotes[]
  shootingCases shooting_cases[]

  @@unique([user_id, photographer_id])
  @@index([user_id])
  @@index([photographer_id])
}

// chat_message
enum MessageType {
  TEXT
  INITIAL_REQUEST
  QUOTE
  SYSTEM
}

model chat_messages {
  id                   String      @id @default(uuid(7)) @db.Uuid
  chat_room_id         String      @db.Uuid
  recipient_account_id String?     @db.Uuid
  message_type         MessageType
  content              String
  payload              Json?
  reservation_id       String?     @db.Uuid
  quote_id             String?     @db.Uuid
  read_at              DateTime?
  created_at           DateTime    @default(now())

  chat_room    chat_rooms     @relation(fields: [chat_room_id], references: [id], onDelete: Cascade)
  auth_account auth_accounts? @relation(fields: [recipient_account_id], references: [id], onDelete: SetNull)
  reservation  reservations?  @relation(fields: [reservation_id], references: [id], onDelete: SetNull)
  quote        quotes?        @relation(fields: [quote_id], references: [id], onDelete: SetNull)

  @@index([chat_room_id, created_at])
}

// shooting_cases: 촬영 건
model shooting_cases {
  id           String   @id @default(uuid(7)) @db.Uuid
  chat_room_id String?  @db.Uuid
  created_at   DateTime @default(now())

  chat_room chat_rooms? @relation(fields: [chat_room_id], references: [id], onDelete: SetNull)
  quotes    quotes[]

  @@index([chat_room_id])
}

// quotes
model quotes {
  id                String   @id @default(uuid(7)) @db.Uuid
  chat_room_id      String?  @db.Uuid
  shooting_case_id  String @db.Uuid
  photographer_id   String?  @db.Uuid
  quote_name        String
  version           Int
  shoot_at          DateTime
  location          String
  location_lat      Float // 위도 (네이버 지도에서 고른 촬영 장소)
  location_lng      Float // 경도
  duration_minutes  Int
  price             Int
  photo_count       Int?
  includes_original Boolean
  additional_notice String?
  common_notice     String?
  created_at        DateTime @default(now())

  chat_room    chat_rooms?     @relation(fields: [chat_room_id], references: [id], onDelete: SetNull)
  shooting_case shooting_cases @relation(fields: [shooting_case_id], references: [id], onDelete: Restrict)
  photographer photographers?  @relation(fields: [photographer_id], references: [id], onDelete: SetNull)
  chatMessage  chat_messages[]
  reservation  reservations?
  payment      payments[]

  @@unique([shooting_case_id, version])
}

// payments
enum PaymentMethod {
  EASY_PAY
}

enum PaymentProvider {
  TOSS
}

enum PaymentStatus {
  READY
  PENDING
  SUCCEEDED
  FAILED
  CANCELED
}

model payments {
  id              String          @id @default(uuid(7)) @db.Uuid
  quote_id        String?         @db.Uuid
  user_id         String?         @db.Uuid
  photographer_id String?         @db.Uuid
  amount          Int
  payment_method  PaymentMethod
  pg_provider     PaymentProvider
  pg_order_id     String          @unique @default(uuid(7)) @db.Uuid
  pg_payment_id   String?         @unique
  status          PaymentStatus
  failure_code    String?
  created_at      DateTime        @default(now())
  paid_at         DateTime?
  updated_at      DateTime        @updatedAt

  quote        quotes?        @relation(fields: [quote_id], references: [id], onDelete: SetNull)
  user         users?         @relation(fields: [user_id], references: [id], onDelete: SetNull)
  photographer photographers? @relation(fields: [photographer_id], references: [id], onDelete: SetNull)
  reservation  reservations?

  @@index([user_id])
  @@index([photographer_id])
}

// reviews
model reviews {
  id              String    @id @default(uuid(7)) @db.Uuid
  reservation_id  String?   @unique @db.Uuid
  user_id         String?   @db.Uuid
  photographer_id String?   @db.Uuid
  rating          Int
  comment         String
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
  deleted_at      DateTime?

  reservation  reservations?   @relation(fields: [reservation_id], references: [id], onDelete: SetNull)
  user         users?          @relation(fields: [user_id], references: [id], onDelete: SetNull)
  photographer photographers?  @relation(fields: [photographer_id], references: [id], onDelete: SetNull)
  reviewReply  review_replies?

  @@index([user_id])
  @@index([photographer_id])
}

// review_replies
model review_replies {
  id         String    @id @default(uuid(7)) @db.Uuid
  review_id  String?   @unique @db.Uuid
  comment    String
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  review reviews? @relation(fields: [review_id], references: [id], onDelete: SetNull)
}

// review_summaries: 작가별 AI 리뷰 요약 (작가당 1행)
enum ReviewSummaryResult {
  OK
  REFUSED
  INVALID
  ERROR
}

model review_summaries {
  photographer_id String @id @db.Uuid

  // 마지막으로 성공한 요약
  summary           String?
  highlights        Json      @default("[]") // [{ label, reviewIds }]
  caution           Json? // { text, reviewIds }
  source_review_ids String[]  @default([]) // 요약에 쓴 리뷰 ID
  source_key        String? // 요약에 쓴 리뷰의 (id, updated_at) 해시
  model             String? // 실제로 응답한 모델
  prompt_version    String?
  generated_at      DateTime?

  // 마지막 시도
  last_attempt_key    String?
  last_attempt_result ReviewSummaryResult?
  last_attempt_at     DateTime?
  locked_until        DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  photographer photographers @relation(fields: [photographer_id], references: [id], onDelete: Cascade)
}

// 추천 LLM 알고리즘 전용 테이블
// feature 값은 LLM 응답 그대로 문자열로 저장

// LLM 분석 시도 결과
enum FeatureAnalysisResult {
  OK
  REFUSED
  INVALID
  ERROR
}

// 추천 입력으로 쓰는 사용자 행동 (가중치는 코드에서 type별로 관리)
enum InteractionType {
  LIKE
  UNLIKE
  SAVE
  UNSAVE
  QUOTE
  RESERVE
  REVIEW
}

// 사용자 행동 기록: 추가만 하고 수정·삭제하지 않는다
// 기존 테이블(photo_likes 등)은 현재 상태, 이 테이블은 추천 입력용 이력
model user_interactions {
  id              String          @id @default(uuid(7)) @db.Uuid
  user_id         String          @db.Uuid
  type            InteractionType
  photo_id        String?         @db.Uuid // 사진 단위 행동 (LIKE, UNLIKE)
  photographer_id String?         @db.Uuid // 작가 단위 행동 (SAVE, QUOTE, RESERVE, REVIEW)
  rating          Int? // REVIEW일 때 평점
  created_at      DateTime        @default(now())

  user         users          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  photo        photos?        @relation(fields: [photo_id], references: [id], onDelete: SetNull)
  photographer photographers? @relation(fields: [photographer_id], references: [id], onDelete: SetNull)

  @@index([user_id, created_at])
}

// 사진 LLM 분석 결과 (사진 1장당 1행)
model photo_features {
  photo_id String @id @db.Uuid

  // 마지막으로 성공한 분석 (실패 중이면 null)
  subject         String?
  place           String?
  time            String?
  weather         String?
  light_source    String?
  light_direction String?
  exposure        String?
  color           String?
  shot_size       String?
  angle           String?
  people_count    String?
  pose            String?
  gaze            String?
  mood            String?
  summary         String?
  model           String? // 실제로 응답한 모델, 혹시 모델을 변경하는 등의 상황을 역 트래킹하기 위한 컬럼
  prompt_version  String? // 해당 컬럼도 동일. Prompt를 수정했을 시 
  analyzed_at     DateTime?

  // 사진 벡터 e: 위 feature로 조립한 글을 임베딩 (배열은 nullable 불가 → 빈 배열 = 임베딩 전)
  embedding       Float[]   @default([])
  embedding_model String? // 사용자 벡터 h와 같은 모델이어야 비교 가능
  embedded_at     DateTime?
  cluster_id      Int? // h가 없는 사용자(비회원·작가·이력 없음)에게 군집별로 골고루 노출할 때 사용

  // 마지막 시도
  last_attempt_result FeatureAnalysisResult?
  last_attempt_at     DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  photo photos @relation(fields: [photo_id], references: [id], onDelete: Cascade)
}

// 작가 LLM 분석 결과 (작가 1명당 1행, 작가가 올린 사진들의 photo_features를 LLM으로 요약)
// user_features를 만들 때 SAVE, QUOTE, RESERVE, REVIEW 행동의 입력으로 사용 (Verbalizer 텍스트용이라 임베딩 없음)
model photographer_features {
  photographer_id String @id @db.Uuid

  // 마지막으로 성공한 분석 (photo_features와 같은 feature 구성)
  subject         String?
  place           String?
  time            String?
  weather         String?
  light_source    String?
  light_direction String?
  exposure        String?
  color           String?
  shot_size       String?
  angle           String?
  people_count    String?
  pose            String?
  gaze            String?
  mood            String?
  summary         String? // 작가 스타일 요약
  model           String?
  prompt_version  String?
  analyzed_at     DateTime?

  // 재생성: 작가가 올린 사진의 캡션 분석이 끝난 뒤 실행
  // 반영된 마지막 사진 분석 시각 (실패 후 재시도 때 photo_features.analyzed_at 최신값과 비교해 누락 확인)
  source_photo_analyzed_at DateTime?

  // 마지막 시도
  last_attempt_result FeatureAnalysisResult?
  last_attempt_at     DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  photographer photographers @relation(fields: [photographer_id], references: [id], onDelete: Cascade)
}

// 사용자 LLM 분석 결과 (사용자 1명당 1행, photo_features와 같은 feature 구성)
model user_features {
  user_id String @id @db.Uuid

  // 마지막으로 성공한 분석
  subject         String?
  place           String?
  time            String?
  weather         String?
  light_source    String?
  light_direction String?
  exposure        String?
  color           String?
  shot_size       String?
  angle           String?
  people_count    String?
  pose            String?
  gaze            String?
  mood            String?
  summary         String? // 취향 요약
  model           String?
  prompt_version  String?
  analyzed_at     DateTime?

  // 다시 분석할지 판단하는 기준: user_interaction 테이블의 최신 이력보다 이전에 생성되었다면 LLM 재생성
  source_interaction_at DateTime?

  // 사용자 벡터 h: 위 feature로 조립한 글을 임베딩 (photo_features와 같은 조립 방식·모델)
  embedding       Float[]   @default([])
  embedding_model String?
  embedded_at     DateTime? // h 버전 (피드 seed에 넣어 스크롤 중 같은 h로 정렬)

  // 직전 h: 스크롤 도중 h가 갱신돼도 seed의 이전 버전으로 순서를 재현
  previous_embedding   Float[]   @default([])
  previous_embedded_at DateTime?

  // 마지막 시도
  last_attempt_result FeatureAnalysisResult?
  last_attempt_at     DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

// 사진 가치 점수 (사진 1장당 1행, 하루 1번 배치로 전체 재계산, 피드 요청 때는 읽기만)
// 합계 하나가 아니라 재료를 칸별로 저장: 프리셋 비율 w는 요청 시점에 곱한다
model photo_value_scores {
  photo_id String @id @db.Uuid

  photo_score         Float   @default(0) // 이 사진이 받은 좋아요 (시간 감쇠)
  photographer_score  Float   @default(0) // 이 사진 작가의 저장·견적·예약 + 리뷰 평점 보정 (시간 감쇠)
  is_new_photographer Boolean @default(false) // 새 작가 여부 (예: 가입 14일 이내)

  updated_at DateTime @updatedAt // 마지막 계산 시각

  photo photos @relation(fields: [photo_id], references: [id], onDelete: Cascade)
}
