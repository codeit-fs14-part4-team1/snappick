// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// 조순님 파트
// auth_accounts
enum AccountType {
  USER
  PHOTOGRAPHER
}

model auth_accounts {
  id           String      @id @default(uuid())
  account_type AccountType
  created_at   DateTime    @default(now())
  updated_at   DateTime    @updatedAt

  auth_provider              auth_providers[]
  auth_refresh_token         auth_refresh_tokens[]
  user                       users?
  photographer               photographers?
  reservation_cancel_request reservation_cancel_requests[]
  notification               notifications[]
  chatMessage                chat_messages[]
}

// auth_providers
enum Provider {
  BASIC
  GOOGLE
  KAKAO
  NAVER
}

model auth_providers {
  id               String        @id @default(uuid())
  auth_account_id  String
  provider         Provider
  provider_email   String
  password_hash    String?
  provider_user_id String?
  created_at       DateTime      @default(now())
  auth_account     auth_accounts @relation(fields: [auth_account_id], references: [id], onDelete: Cascade)

  @@unique([auth_account_id, provider])
  @@unique([provider, provider_user_id])
}

// auth_refresh_tokens
model auth_refresh_tokens {
  id              String    @id @default(uuid())
  auth_account_id String
  token_hash      String    @unique
  family_id       String
  revoked_at      DateTime?
  replaced_by_id  String?   @unique
  created_at      DateTime  @default(now())

  auth_account auth_accounts        @relation(fields: [auth_account_id], references: [id], onDelete: Cascade)
  replaced_by  auth_refresh_tokens? @relation("TokenReplacement", fields: [replaced_by_id], references: [id], onDelete: SetNull)
  replace      auth_refresh_tokens? @relation("TokenReplacement")
}

// users
model users {
  id                String   @id @default(uuid())
  auth_account_id   String   @unique
  nickname          String
  profile_image_url String?
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  auth_account     auth_accounts        @relation(fields: [auth_account_id], references: [id], onDelete: Cascade)
  photoLike        photo_likes[]
  photographerSave photographer_saves[]
  chatRoom         chat_rooms[]
  payment          payments[]
  review           reviews[]
  reservation      reservations[]
}

// photographers
model photographers {
  id                String   @id @default(uuid())
  auth_account_id   String   @unique
  profile_image_url String?
  nickname          String
  career            Int
  regions           String[]
  introduction      String?
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  auth_account     auth_accounts        @relation(fields: [auth_account_id], references: [id], onDelete: Cascade)
  product          products[]
  photo            photos[]
  photographerSave photographer_saves[]
  chatRoom         chat_rooms[]
  quote            quotes[]
  payment          payments[]
  reviewReply      review_replies[]
  reservation      reservations[]
}

// reservations
enum ReservationStatus {
  CONFIRMED
  SHOOT_COMPLETED
  DELIVERED
  PURCHASE_CONFIRMED
  CANCELED
}

model reservations {
  id              String            @id @default(uuid())
  quote_id        String?           @unique
  payment_id      String?           @unique
  user_id         String?
  photographer_id String?
  status          ReservationStatus
  shoot_at        DateTime
  location        String
  total_amount    Int
  request_memo    String?
  created_at      DateTime          @default(now())
  updated_at      DateTime          @updatedAt

  user         users?         @relation(fields: [user_id], references: [id], onDelete: SetNull)
  photographer photographers? @relation(fields: [photographer_id], references: [id], onDelete: SetNull)
  quote        quotes?        @relation(fields: [quote_id], references: [id], onDelete: SetNull)
  payment      payments?      @relation(fields: [payment_id], references: [id], onDelete: SetNull)

  reservation_cancel_request reservation_cancel_requests[]
  deliverable                deliverables?
  chatMessage                chat_messages[]
  review                     reviews?

  @@index([user_id])
  @@index([photographer_id])
}

// reservation_cancel_requests
enum CancelStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model reservation_cancel_requests {
  id             String       @id @default(uuid())
  reservation_id String
  requested_by   String
  reason         String
  status         CancelStatus
  processed_at   DateTime?
  created_at     DateTime     @default(now())
  updated_at     DateTime     @updatedAt

  auth_account auth_accounts @relation(fields: [requested_by], references: [id], onDelete: Cascade)
  reservation  reservations  @relation(fields: [reservation_id], references: [id], onDelete: Cascade)
}

// deliverables
model deliverables {
  id                String   @id @default(uuid())
  reservation_id    String   @unique
  link              String
  expiration_period DateTime
  notice            String?
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  reservation reservations @relation(fields: [reservation_id], references: [id], onDelete: Cascade)

  @@index([reservation_id])
}

// products
model products {
  id                String   @id @default(uuid())
  photographer_id   String
  name              String
  price             Int
  duration_minutes  Int
  photo_count       Int
  includes_original Boolean
  description       String?
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  photographer photographers @relation(fields: [photographer_id], references: [id], onDelete: Cascade)

  @@index([photographer_id])
}

// 용일님 파트
// categories
model categories {
  id            String             @id @default(uuid())
  name          String
  created_at    DateTime           @default(now())
  photoCategory photo_categories[]
}

// styles
model styles {
  id         String         @id @default(uuid())
  name       String
  created_at DateTime       @default(now())
  photoStyle photo_styles[]
}

// photos
model photos {
  id               String   @id @default(uuid())
  photographer_id  String
  description      String?
  storage_location String
  file_size        BigInt
  width            BigInt
  height           BigInt
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  photographer  photographers      @relation(fields: [photographer_id], references: [id], onDelete: Cascade)
  photoStyle    photo_styles[]
  photoCategory photo_categories[]
  photoKeyword  photo_keywords[]
  photoLike     photo_likes[]

  @@index([photographer_id])
}

// photo_styles & photo_categories & photo_keywords & photo_likes & photographer_saves
model photo_styles {
  photo_id String
  style_id String

  photo photos @relation(fields: [photo_id], references: [id], onDelete: Cascade)
  style styles @relation(fields: [style_id], references: [id], onDelete: Cascade)

  @@id([photo_id, style_id])
  @@index([style_id])
}

model photo_categories {
  photo_id    String
  category_id String

  photo    photos     @relation(fields: [photo_id], references: [id], onDelete: Cascade)
  category categories @relation(fields: [category_id], references: [id], onDelete: Cascade)

  @@id([photo_id, category_id])
  @@index([category_id])
}

model photo_keywords {
  id       String @id @default(uuid())
  photo_id String
  keyword  String

  photo photos @relation(fields: [photo_id], references: [id], onDelete: Cascade)

  @@index([photo_id])
  @@index([keyword])
}

model photo_likes {
  user_id    String
  photo_id   String
  created_at DateTime @default(now())

  photo photos @relation(fields: [photo_id], references: [id], onDelete: Cascade)
  user  users  @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([photo_id, user_id])
  @@index([user_id])
}

model photographer_saves {
  user_id         String
  photographer_id String
  created_at      DateTime @default(now())

  photographer photographers @relation(fields: [photographer_id], references: [id], onDelete: Cascade)
  user         users         @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([photographer_id, user_id])
  @@index([user_id])
}

// notifications
enum noti_type {
  NEW_MESSAGE
  NEW_QUOTE
  RESERVATION_CONFIRMED
}

enum noti_target_type {
  CHAT_ROOM
  RESERVATION
  PHOTOGRAPHER_PROFILE
}

model notifications {
  id              String           @id @default(uuid())
  auth_account_id String
  type            noti_type
  target_type     noti_target_type
  target_id       String
  message         String
  scheduled_at    DateTime?
  read_at         DateTime?
  created_at      DateTime         @default(now())

  auth_account auth_accounts @relation(fields: [auth_account_id], references: [id], onDelete: Cascade)
}

// 영일님 파트
// chat_rooms
model chat_rooms {
  id              String   @id @default(uuid())
  user_id         String?
  photographer_id String?
  last_message_at DateTime
  created_at      DateTime @default(now())

  user         users?          @relation(fields: [user_id], references: [id], onDelete: SetNull)
  photographer photographers?  @relation(fields: [photographer_id], references: [id], onDelete: SetNull)
  chatMessage  chat_messages[]
  payload      payloads?
  quote        quotes[]

  @@unique([user_id, photographer_id])
  @@index([user_id])
  @@index([photographer_id])
}

// chat_message
enum message_type {
  TEXT
  INITIAL_REQUEST
  QUOTE
  SYSTEM
}

model chat_messages {
  id              String       @id @default(uuid())
  chat_room_id    String
  auth_account_id String?
  message_type    message_type
  content         String
  payload_id      String?
  reservation_id  String?
  quote_id        String?
  read_at         DateTime?
  created_at      DateTime     @default(now())

  chat_room    chat_rooms     @relation(fields: [chat_room_id], references: [id], onDelete: Cascade)
  auth_account auth_accounts? @relation(fields: [auth_account_id], references: [id], onDelete: SetNull)
  payload      payloads?      @relation(fields: [payload_id], references: [id], onDelete: SetNull)
  reservation  reservations?  @relation(fields: [reservation_id], references: [id], onDelete: SetNull)
  quote        quotes?        @relation(fields: [quote_id], references: [id], onDelete: SetNull)
}

// payloads
model payloads {
  id           String   @id @default(uuid())
  chat_room_id String   @unique
  date         String
  region       String
  concept      String[]
  category     String[]
  created_at   DateTime @default(now())

  chat_room    chat_rooms      @relation(fields: [chat_room_id], references: [id], onDelete: Cascade)
  chatMessages chat_messages[]
}

// quotes
model quotes {
  id                String   @id @default(uuid())
  chat_room_id      String?
  photographer_id   String?
  name              String
  version           Int
  shoot_at          DateTime
  location          String
  duration_minutes  Int
  cost              Int
  extra_fee         Int
  photo_count       Int
  includes_original Boolean
  additional_notice String?
  common_notice     String
  created_at        DateTime @default(now())

  chat_room    chat_rooms?     @relation(fields: [chat_room_id], references: [id], onDelete: SetNull)
  photographer photographers?  @relation(fields: [photographer_id], references: [id], onDelete: SetNull)
  chatMessage  chat_messages[]
  reservation  reservations?
  payment      payments?

  @@unique([chat_room_id, version])
}

// payments
enum payment_methods {
  CARD
  ACCOUNT
  ETC
}

enum payment_provider {
  TOSS
  KAKAO
  ETC
}

enum payment_status {
  READY
  PENDING
  SUCCEEDED
  FAILED
  CANCELED
}

model payments {
  id              String           @id @default(uuid())
  quote_id        String?          @unique
  user_id         String?
  photographer_id String?
  amount          Int
  payment_method  payment_methods
  pg_provider     payment_provider
  pg_order_id     String           @default(uuid())
  pg_payment_id   String?
  status          payment_status
  failure_code    String?
  created_at      DateTime         @default(now())
  paid_at         DateTime?
  updated_at      DateTime         @updatedAt

  quote        quotes?        @relation(fields: [quote_id], references: [id], onDelete: SetNull)
  user         users?         @relation(fields: [user_id], references: [id], onDelete: SetNull)
  photographer photographers? @relation(fields: [photographer_id], references: [id], onDelete: SetNull)
  reservation  reservations?

  @@index([user_id])
  @@index([photographer_id])
}

// reviews
model reviews {
  id             String    @id @default(uuid())
  reservation_id String?   @unique
  user_id        String?
  rating         Int
  comment        String
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt
  deleted_at     DateTime?

  reservation reservations?   @relation(fields: [reservation_id], references: [id], onDelete: SetNull)
  user        users?          @relation(fields: [user_id], references: [id], onDelete: SetNull)
  reviewReply review_replies?

  @@index([user_id])
}

// review_replies
model review_replies {
  id              String    @id @default(uuid())
  review_id       String?   @unique
  photographer_id String?
  comment         String
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
  deleted_at      DateTime?

  review       reviews?       @relation(fields: [review_id], references: [id], onDelete: SetNull)
  photographer photographers? @relation(fields: [photographer_id], references: [id], onDelete: SetNull)
}
