// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// 조순님 파트
// auth_accounts
enum AccountType {
  USER
  PHOTOGRAPHER
}

model auth_accounts {
  id           String      @id @default(uuid(7)) @db.Uuid
  account_type AccountType
  created_at   DateTime    @default(now())
  updated_at   DateTime    @updatedAt

  auth_provider              auth_providers[]
  auth_refresh_token         auth_refresh_tokens[]
  user                       users?
  photographer               photographers?
  reservation_cancel_request reservation_cancel_requests[]
  notification               notifications[]
  chatMessage                chat_messages[]
}

// auth_providers
enum Provider {
  BASIC
  GOOGLE
  KAKAO
  NAVER
}

model auth_providers {
  id               String        @id @default(uuid(7)) @db.Uuid
  auth_account_id  String        @db.Uuid
  provider         Provider
  provider_email   String
  password_hash    String?
  provider_user_id String?
  created_at       DateTime      @default(now())
  auth_account     auth_accounts @relation(fields: [auth_account_id], references: [id], onDelete: Cascade)

  @@unique([auth_account_id, provider])
  @@unique([provider, provider_user_id])
}

// auth_refresh_tokens
model auth_refresh_tokens {
  id              String    @id @default(uuid(7)) @db.Uuid
  auth_account_id String    @db.Uuid
  token_hash      String    @unique
  family_id       String    @default(uuid(7)) @db.Uuid
  revoked_at      DateTime?
  replaced_by_id  String?   @unique @db.Uuid
  created_at      DateTime  @default(now())

  auth_account auth_accounts        @relation(fields: [auth_account_id], references: [id], onDelete: Cascade)
  replaced_by  auth_refresh_tokens? @relation("TokenReplacement", fields: [replaced_by_id], references: [id], onDelete: SetNull)
  replace      auth_refresh_tokens? @relation("TokenReplacement")

  @@index([family_id])
}

// users
model users {
  id                String   @id @default(uuid(7)) @db.Uuid
  auth_account_id   String   @unique @db.Uuid
  nickname          String
  profile_image_url String?
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  auth_account     auth_accounts        @relation(fields: [auth_account_id], references: [id], onDelete: Cascade)
  photoLike        photo_likes[]
  photographerSave photographer_saves[]
  chatRoom         chat_rooms[]
  payment          payments[]
  review           reviews[]
  reservation      reservations[]
}

// photographers
model photographers {
  id                String   @id @default(uuid(7)) @db.Uuid
  auth_account_id   String   @unique @db.Uuid
  profile_image_url String?
  nickname          String
  career            Int?
  regions           String[]
  introduction      String?
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  auth_account        auth_accounts          @relation(fields: [auth_account_id], references: [id], onDelete: Cascade)
  product             products[]
  photo               photos[]
  photographerSave    photographer_saves[]
  chatRoom            chat_rooms[]
  quote               quotes[]
  payment             payments[]
  reservation         reservations[]
  reviews             reviews[]
  representativePhoto representative_photos?
}

// reservations
enum ReservationStatus {
  CONFIRMED
  SHOOT_COMPLETED
  DELIVERED
  PURCHASE_CONFIRMED
  CANCELED
}

model reservations {
  id              String            @id @default(uuid(7)) @db.Uuid
  quote_id        String?           @unique @db.Uuid
  payment_id      String?           @unique @db.Uuid
  user_id         String?           @db.Uuid
  photographer_id String?           @db.Uuid
  status          ReservationStatus
  shoot_at        DateTime
  location        String
  total_amount    Int
  created_at      DateTime          @default(now())
  updated_at      DateTime          @updatedAt

  user         users?         @relation(fields: [user_id], references: [id], onDelete: SetNull)
  photographer photographers? @relation(fields: [photographer_id], references: [id], onDelete: SetNull)
  quote        quotes?        @relation(fields: [quote_id], references: [id], onDelete: SetNull)
  payment      payments?      @relation(fields: [payment_id], references: [id], onDelete: SetNull)

  reservation_cancel_request reservation_cancel_requests[]
  deliverable                deliverables?
  chatMessage                chat_messages[]
  review                     reviews?

  @@index([user_id])
  @@index([photographer_id])
}

// reservation_cancel_requests
enum CancelStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model reservation_cancel_requests {
  id                      String       @id @default(uuid(7)) @db.Uuid
  reservation_id          String       @db.Uuid
  requested_by_account_id String       @db.Uuid
  reason                  String
  status                  CancelStatus
  processed_at            DateTime?
  created_at              DateTime     @default(now())
  updated_at              DateTime     @updatedAt

  auth_account auth_accounts @relation(fields: [requested_by_account_id], references: [id], onDelete: Cascade)
  reservation  reservations  @relation(fields: [reservation_id], references: [id], onDelete: Cascade)
}

// deliverables
model deliverables {
  id                String   @id @default(uuid(7)) @db.Uuid
  reservation_id    String   @unique @db.Uuid
  link              String
  expiration_period DateTime
  notice            String?
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  reservation reservations @relation(fields: [reservation_id], references: [id], onDelete: Cascade)
}

// products
model products {
  id                String   @id @default(uuid(7)) @db.Uuid
  photographer_id   String   @db.Uuid
  name              String
  price             Int
  duration_minutes  Int
  photo_count       Int
  includes_original Boolean
  common_notice     String?
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  photographer photographers @relation(fields: [photographer_id], references: [id], onDelete: Cascade)

  @@index([photographer_id])
}

// 용일님 파트
// categories
model categories {
  id            String             @id @default(uuid(7)) @db.Uuid
  name          String
  created_at    DateTime           @default(now())
  photoCategory photo_categories[]
}

// styles
model styles {
  id         String         @id @default(uuid(7)) @db.Uuid
  name       String
  created_at DateTime       @default(now())
  photoStyle photo_styles[]
}

// photos
model photos {
  id               String   @id @default(uuid(7)) @db.Uuid
  photographer_id  String   @db.Uuid
  description      String?
  storage_location String
  width            Int
  height           Int
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  photographer        photographers           @relation(fields: [photographer_id], references: [id], onDelete: Cascade)
  photoStyle          photo_styles[]
  photoCategory       photo_categories[]
  photoKeyword        photo_keywords[]
  photoLike           photo_likes[]
  representativePhoto representative_photos[]

  @@index([photographer_id])
}

// photo_styles & photo_categories & photo_keywords & photo_likes & photographer_saves
model photo_styles {
  photo_id String @db.Uuid
  style_id String @db.Uuid

  photo photos @relation(fields: [photo_id], references: [id], onDelete: Cascade)
  style styles @relation(fields: [style_id], references: [id], onDelete: Cascade)

  @@id([photo_id, style_id])
  @@index([style_id])
}

model photo_categories {
  photo_id    String @db.Uuid
  category_id String @db.Uuid

  photo    photos     @relation(fields: [photo_id], references: [id], onDelete: Cascade)
  category categories @relation(fields: [category_id], references: [id], onDelete: Cascade)

  @@id([photo_id, category_id])
  @@index([category_id])
}

model photo_keywords {
  id       String @id @default(uuid(7)) @db.Uuid
  photo_id String @db.Uuid
  keyword  String

  photo photos @relation(fields: [photo_id], references: [id], onDelete: Cascade)

  @@index([photo_id])
  @@index([keyword])
}

model photo_likes {
  user_id    String   @db.Uuid
  photo_id   String   @db.Uuid
  created_at DateTime @default(now())

  photo photos @relation(fields: [photo_id], references: [id], onDelete: Cascade)
  user  users  @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([photo_id, user_id])
  @@index([user_id])
}

model photographer_saves {
  user_id         String   @db.Uuid
  photographer_id String   @db.Uuid
  created_at      DateTime @default(now())

  photographer photographers @relation(fields: [photographer_id], references: [id], onDelete: Cascade)
  user         users         @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([photographer_id, user_id])
  @@index([user_id])
}

model representative_photos {
  photographer_id String @id @db.Uuid
  photo_id        String @db.Uuid

  photographer photographers @relation(fields: [photographer_id], references: [id], onDelete: Cascade)
  photo        photos        @relation(fields: [photo_id], references: [id], onDelete: Cascade)
}

// notifications
enum NotiType {
  NEW_MESSAGE
  NEW_INQUIRY
  NEW_QUOTE
  RESERVATION_CONFIRMED
  SHOOT_REMINDER
  DELIVERY_COMPLETED
  NEW_REVIEW
  CANCEL_REQUESTED
  CANCEL_REJECTED
  RESERVATION_CANCELED
}

enum NotiTargetType {
  CHAT_ROOM
  RESERVATION
  PHOTOGRAPHER_PROFILE
}

model notifications {
  id              String         @id @default(uuid(7)) @db.Uuid
  auth_account_id String         @db.Uuid
  type            NotiType
  target_type     NotiTargetType
  target_id       String
  message         String
  scheduled_at    DateTime?
  read_at         DateTime?
  created_at      DateTime       @default(now())

  auth_account auth_accounts @relation(fields: [auth_account_id], references: [id], onDelete: Cascade)

  @@index([auth_account_id, created_at])
}

// 영일님 파트
// chat_rooms
model chat_rooms {
  id              String   @id @default(uuid(7)) @db.Uuid
  user_id         String?  @db.Uuid
  photographer_id String?  @db.Uuid
  last_message_at DateTime @default(now())
  created_at      DateTime @default(now())

  user         users?          @relation(fields: [user_id], references: [id], onDelete: SetNull)
  photographer photographers?  @relation(fields: [photographer_id], references: [id], onDelete: SetNull)
  chatMessage  chat_messages[]
  quote        quotes[]

  @@unique([user_id, photographer_id])
  @@index([user_id])
  @@index([photographer_id])
}

// chat_message
enum MessageType {
  TEXT
  INITIAL_REQUEST
  QUOTE
  SYSTEM
}

model chat_messages {
  id                   String      @id @default(uuid(7)) @db.Uuid
  chat_room_id         String      @db.Uuid
  recipient_account_id String?     @db.Uuid
  message_type         MessageType
  content              String
  payload              Json?
  reservation_id       String?     @db.Uuid
  quote_id             String?     @db.Uuid
  read_at              DateTime?
  created_at           DateTime    @default(now())

  chat_room    chat_rooms     @relation(fields: [chat_room_id], references: [id], onDelete: Cascade)
  auth_account auth_accounts? @relation(fields: [recipient_account_id], references: [id], onDelete: SetNull)
  reservation  reservations?  @relation(fields: [reservation_id], references: [id], onDelete: SetNull)
  quote        quotes?        @relation(fields: [quote_id], references: [id], onDelete: SetNull)

  @@index([chat_room_id, created_at])
}

// quotes
model quotes {
  id                String   @id @default(uuid(7)) @db.Uuid
  chat_room_id      String?  @db.Uuid
  photographer_id   String?  @db.Uuid
  product_name      String
  version           Int
  shoot_at          DateTime
  location          String
  duration_minutes  Int
  price             Int
  extra_fee         Int?
  photo_count       Int
  includes_original Boolean
  additional_notice String?
  common_notice     String?
  created_at        DateTime @default(now())

  chat_room    chat_rooms?     @relation(fields: [chat_room_id], references: [id], onDelete: SetNull)
  photographer photographers?  @relation(fields: [photographer_id], references: [id], onDelete: SetNull)
  chatMessage  chat_messages[]
  reservation  reservations?
  payment      payments[]

  @@unique([chat_room_id, version])
}

// payments
enum PaymentMethod {
  EASY_PAY
}

enum PaymentProvider {
  TOSS
}

enum PaymentStatus {
  READY
  PENDING
  SUCCEEDED
  FAILED
  CANCELED
}

model payments {
  id              String          @id @default(uuid(7)) @db.Uuid
  quote_id        String?         @db.Uuid
  user_id         String?         @db.Uuid
  photographer_id String?         @db.Uuid
  amount          Int
  payment_method  PaymentMethod
  pg_provider     PaymentProvider
  pg_order_id     String          @unique @default(uuid(7)) @db.Uuid
  pg_payment_id   String?         @unique
  status          PaymentStatus
  failure_code    String?
  created_at      DateTime        @default(now())
  paid_at         DateTime?
  updated_at      DateTime        @updatedAt

  quote        quotes?        @relation(fields: [quote_id], references: [id], onDelete: SetNull)
  user         users?         @relation(fields: [user_id], references: [id], onDelete: SetNull)
  photographer photographers? @relation(fields: [photographer_id], references: [id], onDelete: SetNull)
  reservation  reservations?

  @@index([user_id])
  @@index([photographer_id])
}

// reviews
model reviews {
  id              String    @id @default(uuid(7)) @db.Uuid
  reservation_id  String?   @unique @db.Uuid
  user_id         String?   @db.Uuid
  photographer_id String?   @db.Uuid
  rating          Int
  comment         String
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
  deleted_at      DateTime?

  reservation  reservations?   @relation(fields: [reservation_id], references: [id], onDelete: SetNull)
  user         users?          @relation(fields: [user_id], references: [id], onDelete: SetNull)
  photographer photographers?  @relation(fields: [photographer_id], references: [id], onDelete: SetNull)
  reviewReply  review_replies?

  @@index([user_id])
  @@index([photographer_id])
}

// review_replies
model review_replies {
  id         String    @id @default(uuid(7)) @db.Uuid
  review_id  String?   @unique @db.Uuid
  comment    String
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  review reviews? @relation(fields: [review_id], references: [id], onDelete: SetNull)
}
