PORT=4000
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/snappick
ORIGIN=http://localhost:3000
JWT_ACCESS_SECRET=랜덤문자열
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=14
# 만약 백엔드와 프론트의 도메인이 다를 경우 none으로 설정하고 https 인증서를 반드시 발급해야합니다. 그렇지 않으면 브라우저에서 쿠키를 거부합니다.
# 같은 도메인에서 운영하면 lax도 가능합니다.
COOKIE_SAMESITE=none
# 이미지 응답 주소 앞에 붙는 값 (개발: 목 이미지가 있는 web 주소, 운영: S3·CDN 주소)
IMAGE_BASE_URL=http://localhost:3000
# 사진 업로드 저장소 (local: apps/web/public 아래에 저장, s3: S3_BUCKET에 저장). 비우면 개발은 local, 배포는 s3
STORAGE_DRIVER=local
# S3_BUCKET=snappick-staging-photos
# AWS_REGION=ap-southeast-2
# 로컬에서 S3로 시험할 때만 넣기 (배포 서버는 EB 인스턴스 역할을 쓴다). 확인: pnpm --filter api s3:check
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3 호환 저장소(MinIO 등)로 시험할 때만 넣기
# S3_ENDPOINT=http://localhost:9000
# 카카오 로그인: 카카오 디벨로퍼스 [앱 설정 > 앱 키]의 REST API 키 (FE가 보낸 인가 코드를 토큰으로 바꿀 때 사용). 비우면 카카오 로그인·가입은 503
KAKAO_REST_API_KEY=
# [카카오 로그인 > 보안]에서 Client Secret을 켰을 때만 넣기
KAKAO_CLIENT_SECRET=
# 네이버 로그인: 네이버 개발자센터 [내 애플리케이션]의 Client ID·Client Secret. 비우면 네이버 로그인·가입은 503
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
